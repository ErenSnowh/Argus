# ARGUS environment configuration
# ----------------------------------
# The Gemini API key is loaded from .env or system environment.
# You must copy this file to .env and insert your API key.

# The Gemini API key:
GOOGLE_API_KEY=your_key_here

# Optional. If set, mcp_server/ioc_intel.py calls the live VirusTotal API
# instead of the local demo IOC cache. Get a free key at
# https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Optional model overrides. FAST_MODEL handles triage, enrichment, forensics,
# and remediation; DEEP_MODEL handles compliance + the final report synthesis,
# where reasoning quality matters more than latency.
# Code defaults (agents/sub_agents.py) are gemini-2.5-flash-lite and
# gemini-2.5-flash; uncomment to override.
#GOOGLE_GENAI_FAST_MODEL=gemini-2.5-flash
#GOOGLE_GENAI_DEEP_MODEL=gemini-2.5-pro

# ---------------------------------------------------------------------------
# AIR-GAP / OFFLINE MODE
# ---------------------------------------------------------------------------
# Set OFFLINE=1 to guarantee ARGUS makes NO outbound network calls. This is
# enforced in code (config.py), not just documented:
#   * has_api_key() returns False, so every consumer falls back to the
#     deterministic offline engine (world model + local MCP tools).
#   * The Gemini client is hard-blocked -- generate_content raises instead of
#     reaching the network.
#   * The optional VirusTotal enrichment path is suppressed even if a key is set.
# Forecasting, XAI, kill-chain staging, counterfactuals, and CERT-In/NCIIPC
# report generation all still work offline -- they never needed an LLM.
# Accepts 1/true/yes/on. ARGUS_OFFLINE is also honoured.
OFFLINE=0

# 🚨 Never commit a filled-in .env file. Copy this to .env and fill it in
# locally -- .env is already in .gitignore.
