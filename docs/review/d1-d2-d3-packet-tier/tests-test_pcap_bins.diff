+def test_offset_matching_is_protocol_aware(tmp_path):
+    """A UDP packet must never pair with a TCP flow row on equal ports."""
+    p = tmp_path / "proto.pcap"
+    pkt = IP(src="10.0.0.1", dst="10.0.0.2") / UDP(sport=44000, dport=80)
+    pkt.time = BASE + 10.0
