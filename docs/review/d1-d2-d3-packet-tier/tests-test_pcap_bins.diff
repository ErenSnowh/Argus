+    pcap = _backwards_pcap(tmp_path, "args.pcap")
+    with pytest.raises(SystemExit):
+        mod.main(["--pcap", str(pcap), "--bin-seconds", "0"])
+    with pytest.raises(SystemExit):
+        mod.main(["--pcap", str(pcap), "--reorder-grace-sec", "-1"])
