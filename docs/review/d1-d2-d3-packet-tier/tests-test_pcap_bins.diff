+# --------------------------------------------------------------------------
+# clock offset: observed delta vs guarded apply decision
+# --------------------------------------------------------------------------
+def _offset_pcap(tmp_path, n=4, name="offset.pcap", pkt_ts=BASE + 10.0):
+    """``n`` distinct TCP connections, each first packet at ``pkt_ts``."""
+    p = tmp_path / name
+    pkts = []
+    for i in range(n):
+        pkt = _tcp("10.0.0.1", "10.0.0.2", 44000 + i, 80, seq=1)
+        pkt.time = pkt_ts
+        pkts.append(pkt)
+    wrpcap(str(p), pkts)
+    return p
+
+
+def _offset_flows(deltas):
+    """Flow rows starting ``deltas[i]`` after the matching packet."""
+    return [{"src": "10.0.0.1", "dst": "10.0.0.2", "sport": 44000 + i,
+             "dport": 80, "proto": "tcp", "ts": BASE + 10.0 + d}
+            for i, d in enumerate(deltas)]
+
+
+def test_offset_applied_only_when_measured_and_unambiguous(tmp_path):
+    p = _offset_pcap(tmp_path, n=4)
+    off = measure_clock_offset(p, _offset_flows([7.0] * 4))
+    assert off["status"] == "measured"
+    assert off["apply"]["eligible"] is True
+    assert off["apply"]["correction_sec"] == pytest.approx(7.0)
+    assert off["observed_delta"]["n_matched_pairs"] == 4
+
+
+def test_offset_apply_refused_when_too_few_matches(tmp_path):
+    p = _offset_pcap(tmp_path, n=2)
+    off = measure_clock_offset(p, _offset_flows([7.0] * 2))
+    assert off["median_sec"] == pytest.approx(7.0)   # still reported ...
+    assert off["apply"]["eligible"] is False
+    assert off["apply"]["correction_sec"] is None    # ... never applied as 0
+    assert "too few" in off["apply"]["reason"]
+    assert "too_few_matches" in off["apply"]["flags"]
+
+
+def test_offset_apply_refused_on_ambiguous_dispersion(tmp_path):
+    p = _offset_pcap(tmp_path, n=5)
+    off = measure_clock_offset(p, _offset_flows([0.0, 0.1, 6.0, 6.1, 12.0]))
+    assert off["observed_delta"]["dispersion_iqr_sec"] > 1.0
+    assert off["apply"]["eligible"] is False
+    assert "ambiguous" in off["apply"]["reason"]
+    assert "ambiguous_dispersion" in off["apply"]["flags"]
+
+
+def test_offset_flags_timezone_scale_without_correcting_it(tmp_path):
+    p = _offset_pcap(tmp_path, n=3)
+    off = measure_clock_offset(p, _offset_flows([3600.0] * 3))
+    assert off["median_sec"] == pytest.approx(3600.0)
+    assert "timezone_scale" in off["apply"]["flags"]
+
