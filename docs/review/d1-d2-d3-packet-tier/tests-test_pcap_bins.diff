+def test_tcp_window_null_when_no_tcp_packets(tmp_path):
+    """A covered bin with no TCP must report null, not 0."""
+    p = tmp_path / "udp.pcap"
+    pkt = IP(src="10.0.0.1", dst="10.0.0.9") / UDP(sport=1, dport=2)
+    pkt.time = BASE + 10
