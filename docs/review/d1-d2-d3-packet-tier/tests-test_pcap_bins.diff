+# --------------------------------------------------------------------------
+# streaming implementation guard
+# --------------------------------------------------------------------------
+def test_extractor_streams_with_pcapreader_never_rdpcap():
+    src = (ROOT / "ml" / "world_model" / "pcap_bins.py").read_text(
+        encoding="utf-8")
+    assert "PcapReader" in src
+    assert "import rdpcap" not in src
